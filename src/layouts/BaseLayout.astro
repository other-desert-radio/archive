---
import { ClientRouter } from "astro:transitions";
import type { Page } from "../types/page";

type Props = {
  title: string;
  page: Page;
  returning_page: "shows" | "djs" | "home" | "explore" | "history";
};

const {
  title = "Archive Site",
  page = { name: "shows" },
  returning_page = "home",
} = Astro.props;
import "../styles/global.css";
import "../styles/styles.css";
import Navigation from "../components/Navigation.astro";

---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta
      name="theme-color"
      content={page.name === "tag_page" ? page.color : "#000000"}
    />
    <title>{title}</title>
    <ClientRouter fallback="swap" />
  </head>
  <body transition:animate="none">
    {Astro.slots.has("category-tabs") && (
      <script is:inline>
        // Reserve short-page scroll range before ClientRouter restores history.
        if (history.state?.categoryTabsCompactEntry) {
          document.body.setAttribute("data-compact-category-entry", "");
        }
      </script>
    )}
    <div class="site-background" aria-hidden="true"></div>
    <Navigation page={page} returning_page={returning_page}>
      <slot name="category-tabs" slot="category-tabs" />
    </Navigation>
    <main class:list={{ "full-width": page.name === "history" || page.name === "tag_page" }}>
      <slot />
    </main>
  </body>
</html>

<script>
  import "../utils/preserve-player-navigation";

  document.addEventListener("astro:before-swap", (event) => {
    event.newDocument.documentElement.setAttribute("data-client-navigation", "");
  });
</script>

<style>
  main {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--page-max-width);
    margin-inline: auto;
    padding-bottom: calc(
      var(--container-grid-padding-bottom) + env(safe-area-inset-bottom)
    );
  }

  main.full-width {
    max-width: none;
  }

  @media (max-width: 600px) {
    main {
      padding-bottom: calc(
        var(--container-grid-padding-bottom) +
          max(var(--miniplayer-height, 0px), env(safe-area-inset-bottom))
      );
    }
  }
</style>
