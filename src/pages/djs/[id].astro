---
import { getBasePath } from "../../utils/get-base-path";
import { pathToFileURL } from "node:url";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TagView from "../../components/TagView.astro";
import { fetchDJ, type HydratedDJ } from "../../utils/fetch-dj";
import { fetchDJs } from "../../utils/fetch-djs";
import { fetchTags } from "../../utils/fetch-tags";
import { hydrateTags } from "../../utils/hydrate-tags";
import { fetchShows, type Show } from "../../utils/fetch-shows";
import { SquareShowCard } from "../../components/shows";

const base = getBasePath();

/** Generates static DJ detail pages from the archive summary during Astro builds. */
export async function getStaticPaths() {
  const djs = await fetchDJs(pathToFileURL("src/res/djs_brief.json"));
  const shows = await fetchShows(pathToFileURL("src/res/shows.json"));

  return Promise.all(
    djs.map(async ({ id }) => ({
      params: { id: String(id) },
      props: {
        dj: await fetchDJ(pathToFileURL(`src/res/djs/${id}.json`)),
        djShows: shows.filter((show) => show.djs.some((dj) => dj.id === id)),
      },
    })),
  );
}

type Props = {
  dj: HydratedDJ;
  djShows: Show[];
};

const { dj, djShows } = Astro.props as Props;
const tags = await fetchTags(pathToFileURL("src/res/tags.json"));

const hydratedTags = hydrateTags(dj, tags);
---

<BaseLayout
  page={{ name: "dj_page" }}
  returning_page="djs"
  title={`${dj.title} | Other Desert Radio`}
>
  <h1 class="dj-header">{dj.title}</h1>
  <div class="tag-container">
    {hydratedTags.map((tag) => <TagView tag={tag} size="large" />)}
  </div>

  <div class="dj-grid">
    <div class="dj-column">
      <img
        class="dj-photo image-border-primary"
        decoding="async"
        src={`${base}/${dj.image_large}`}
        alt={dj.title}
      />
      <div set:html={dj.socials} />
    </div>
    <div class="dj-column">
      <div set:html={dj.bio} />
    </div>
  </div>
  {
    djShows.length > 0 && (
      <div class="shows-container">
        <h2 class="show-header">{dj.showTitle}</h2>
        <p class="show-description">{dj.showDescription}</p>
        <div class="shows-grid">
          {djShows.map((show) => (
            <SquareShowCard show={show} base={import.meta.env.BASE_URL} />
          ))}
        </div>
      </div>
    )
  }
</BaseLayout>

<style>
  .dj-photo {
    width: 100%;
    max-width: calc(var(--density-unit) * 38.75);
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    background-color: var(--artwork-placeholder);
  }

  .dj-column {
    display: flex;
    flex-direction: column;
    min-width: 0;
    gap: var(--space-sm);
  }

  .dj-grid {
    display: grid;
    grid-template-columns:
      minmax(
        0,
        clamp(var(--show-artwork-min), 40%, calc(var(--density-unit) * 38.75))
      )
      minmax(0, 1fr);
    column-gap: var(--space-lg);
    row-gap: var(--dj-row-gap, 0);
    overflow-wrap: anywhere;
  }

  .dj-grid :global(p) {
    margin: 0;
  }

  .dj-header {
    margin: 0 0 var(--space-sm);
    font-size: calc(var(--font-title) * 2);
    line-height: 1.3;
  }

  .tag-container {
    margin-bottom: var(--space-md);
  }

  @media (max-width: 750px) {
    .dj-grid {
      column-gap: var(--space-sm);
    }
  }

  @media (max-width: 600px) {
    .dj-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .shows-container {
    margin-top: var(--space-lg);
    overflow-wrap: anywhere;
  }

  .show-header {
    margin: 0 0 var(--space-sm);
    font-weight: normal;
    font-size: var(--font-title);
  }

  .show-description {
    margin: 0 0 var(--space-md);
  }

  .shows-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-lg);
  }

  .no-shows {
    margin: var(--space-lg) 0;
    text-align: center;
    width: 100%;
  }

  @media (max-width: 1600px) {
    .shows-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 1023px) {
    .shows-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .shows-grid {
      gap: var(--space-sm);
    }
  }
</style>
