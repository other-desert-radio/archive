---
import { getBasePath } from "../../utils/get-base-path";
import { pathToFileURL } from "node:url";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { tagBreakdown } from "../../utils/tag-breakdown";
import { fetchDJ, type HydratedDJ } from "../../utils/fetch-dj";
import { fetchDJs } from "../../utils/fetch-djs";
import { fetchTags } from "../../utils/fetch-tags";
import { hydrateTags } from "../../utils/hydrate-tags";
import { fetchShows, type Show } from "../../utils/fetch-shows";
import { SquareShowCard } from "../../components/shows";

const base = getBasePath();

/** Generates static DJ detail pages from the archive summary during Astro builds. */
export async function getStaticPaths() {
  const djs = await fetchDJs(pathToFileURL("public/resources/djs_brief.json"));
  const shows = await fetchShows(pathToFileURL("public/resources/shows.json"));

  return Promise.all(
    djs.map(async ({ id }) => ({
      params: { id: String(id) },
      props: {
        dj: await fetchDJ(pathToFileURL(`public/resources/djs/${id}.json`)),
        djShows: shows.filter((show) => show.djs.some((dj) => dj.id === id)),
      },
    })),
  );
}

type Props = {
  dj: HydratedDJ;
  djShows: Show[];
};

const { dj, djShows } = Astro.props as Props;
const tags = await fetchTags(pathToFileURL("public/resources/tags.json"));

const hydratedTags = hydrateTags(dj, tags);
const breakdown = tagBreakdown(hydratedTags, djShows);
---

<BaseLayout
  page={{ name: "dj_page" }}
  returning_page="djs"
  title={`${dj.title} | Other Desert Radio`}
>
  <h1 class="dj-header">{dj.title}</h1>
  {breakdown.length > 0 && (
    <section class="tag-breakdown" aria-label="Tags">
      <div class="tag-bar">
        {breakdown.map(({ tag, percent }) => (
          <a
            class="tag-segment"
            href={`${base}/tags/${tag.id}`}
            title={tag.title}
            aria-label={tag.title}
            style={{ backgroundColor: tag.color, width: `${percent}%` }}
          >
            <span class="tag-label">{tag.title}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <div class="dj-grid">
    <div class="dj-column">
      {
        dj.image_large && (
          <img
            class="dj-photo image-border-primary"
            decoding="async"
            src={`${base}/${dj.image_large}`}
            alt={dj.title}
          />
        )
      }
      <div set:html={dj.socials} />
    </div>
    <div class="dj-column">
      <div set:html={dj.bio} />
    </div>
  </div>
  {
    djShows.length > 0 && (
      <div class="shows-container">
        <h2 class="show-header">{dj.showTitle}</h2>
        <p class="show-description">{dj.showDescription}</p>
        <div class="shows-grid">
          {djShows.map((show) => (
            <SquareShowCard show={show} base={import.meta.env.BASE_URL} />
          ))}
        </div>
      </div>
    )
  }
</BaseLayout>

<style>
  .dj-photo {
    width: 100%;
    max-width: calc(var(--density-unit) * 38.75);
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    background-color: var(--artwork-placeholder);
  }

  .dj-column {
    display: flex;
    flex-direction: column;
    min-width: 0;
    gap: var(--space-sm);
  }

  .dj-grid {
    display: grid;
    grid-template-columns:
      minmax(
        0,
        clamp(var(--show-artwork-min), 40%, calc(var(--density-unit) * 38.75))
      )
      minmax(0, 1fr);
    column-gap: var(--space-lg);
    row-gap: var(--dj-row-gap, 0);
    overflow-wrap: anywhere;
  }

  .dj-grid :global(p) {
    margin: 0;
  }

  .dj-header {
    margin: 0 0 var(--space-sm);
    font-size: calc(var(--font-title) * 2);
    line-height: 1.3;
  }

  .tag-breakdown {
    margin-bottom: var(--space-md);
  }

  .tag-bar {
    display: flex;
    height: calc(var(--density-unit) * 2.5);
  }

  .tag-segment {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    flex-shrink: 0;
    color: black;
    text-decoration: none;
    overflow: hidden;
  }

  .tag-segment:focus-visible {
    outline: var(--border-secondary) solid black;
    outline-offset: calc(-1 * var(--border-secondary));
  }

  .tag-label {
    flex-shrink: 0;
    white-space: nowrap;
    padding-inline: var(--space-xs);
    font-size: var(--font-small);
    font-weight: bold;
    line-height: 1.2;
    text-align: center;
    visibility: hidden;
  }

  .tag-segment:focus-visible {
    z-index: 1;
    overflow: visible;
  }

  .tag-segment:focus-visible .tag-label {
    display: flex;
    align-items: center;
    height: 100%;
    background-color: inherit;
    scale: 1 !important;
  }

  @media (hover: hover) and (pointer: fine) {
    .tag-segment:hover {
      z-index: 1;
      overflow: visible;
    }

    .tag-segment:hover .tag-label {
      display: flex;
      align-items: center;
      height: 100%;
      background-color: inherit;
      scale: 1 !important;
    }
  }

  @media (max-width: 750px) {
    .dj-grid {
      column-gap: var(--space-sm);
    }
  }

  @media (max-width: 600px) {
    .tag-bar {
      height: calc(var(--density-unit) * 3);
    }

    .dj-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .shows-container {
    margin-top: var(--space-lg);
    overflow-wrap: anywhere;
  }

  .show-header {
    margin: 0 0 var(--space-sm);
    font-weight: normal;
    font-size: var(--font-title);
  }

  .show-description {
    margin: 0 0 var(--space-md);
  }

  .shows-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-lg);
  }

  .no-shows {
    margin: var(--space-lg) 0;
    text-align: center;
    width: 100%;
  }

  @media (max-width: 1600px) {
    .shows-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 1023px) {
    .shows-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .shows-grid {
      gap: var(--space-sm);
    }
  }
</style>

<script>
  const observer = new ResizeObserver((entries) => {
    for (const { target } of entries) {
      const label = target.querySelector<HTMLElement>(".tag-label");
      if (label) {
        label.style.scale = String(Math.min(1, target.clientWidth / label.offsetWidth));
        label.style.visibility = "visible";
      }
    }
  });

  function observeTags() {
    observer.disconnect();
    document.querySelectorAll(".tag-segment").forEach((segment) => observer.observe(segment));
  }

  observeTags();
  document.addEventListener("astro:page-load", observeTags);
  document.addEventListener("astro:before-swap", () => observer.disconnect());
</script>
