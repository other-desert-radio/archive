---
import { pathToFileURL } from "node:url";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TagView from "../../components/TagView.astro";
import { fetchDJ, type HydratedDJ } from "../../utils/fetch-dj";
import { fetchDJs } from "../../utils/fetch-djs";
import { fetchTags } from "../../utils/fetch-tags";
import { hydrateTags } from "../../utils/hydrate-tags";

type Props = {
  dj: HydratedDJ;
};

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

/** Generates static DJ detail pages from the archive summary during Astro builds. */
export async function getStaticPaths() {
  const djs = await fetchDJs(pathToFileURL("src/res/djs_brief.json"));

  return Promise.all(
    djs.map(async ({ id }) => ({
      params: { id: String(id) },
      props: {
        dj: await fetchDJ(pathToFileURL(`src/res/djs/${id}.json`)),
      },
    })),
  );
}

const { dj } = Astro.props as Props;
const tags = await fetchTags(pathToFileURL("src/res/tags.json"));

const hydratedTags = hydrateTags(dj, tags);
---

<BaseLayout
  page={{ name: "dj_page" }}
  returning_page="djs"
  title={`${dj.title} | Other Desert Radio`}
>
  <div class="detail-grid">
    <h1 class="detail-header">{dj.title}</h1>
    <div class="detail-column">
      <img class="detail-photo" decoding="async" src={`${base}/${dj.image_large}`} alt={dj.title} />
      <div class="tag-container">
        {hydratedTags.map((tag) => <TagView tag={tag} size="normal" />)}
      </div>
      <div set:html={dj.socials} />
    </div>
    <div class="detail-column">
      <div set:html={dj.bio} />
      <p>{dj.showTitle}</p>
      <p>{dj.showDescription}</p>
    </div>
  </div>
</BaseLayout>
