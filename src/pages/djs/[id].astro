---
import { pathToFileURL } from "node:url";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TagView from "../../components/TagView.astro";
import { fetchDJ, type HydratedDJ } from "../../utils/fetch-dj";
import { fetchDJs } from "../../utils/fetch-djs";
import { fetchTags } from "../../utils/fetch-tags";
import { hydrateTags } from "../../utils/hydrate-tags";
import { fetchShows, type Show } from "../../utils/fetch-shows";
import SquareShowCard from "../../components/shows/SquareShowCard";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

/** Generates static DJ detail pages from the archive summary during Astro builds. */
export async function getStaticPaths() {
  const djs = await fetchDJs(pathToFileURL("src/res/djs_brief.json"));
  const shows = await fetchShows(pathToFileURL("src/res/shows.json"));

  return Promise.all(
    djs.map(async ({ id }) => ({
      params: { id: String(id) },
      props: {
        dj: await fetchDJ(pathToFileURL(`src/res/djs/${id}.json`)),
        djShows: shows.filter((show) => show.djs.some((dj) => dj.id === id)),
      },
    })),
  );
}

type Props = {
  dj: HydratedDJ;
  djShows: Show[];
};

const { dj, djShows } = Astro.props as Props;
const tags = await fetchTags(pathToFileURL("src/res/tags.json"));

const hydratedTags = hydrateTags(dj, tags);
---

<BaseLayout
  page={{ name: "dj_page" }}
  returning_page="djs"
  title={`${dj.title} | Other Desert Radio`}
>
  <div class="detail-grid">
    <h1 class="detail-header">{dj.title}</h1>
    <div class="detail-column">
      <img
        class="detail-photo"
        decoding="async"
        src={`${base}/${dj.image_large}`}
        alt={dj.title}
      />
      <div class="tag-container">
        {hydratedTags.map((tag) => <TagView tag={tag} size="normal" />)}
      </div>
      <div set:html={dj.socials} />
    </div>
    <div class="detail-column">
      <div set:html={dj.bio} />
      <p>{dj.showTitle}</p>
      <p>{dj.showDescription}</p>
    </div>
  </div>
  <div class="shows-container">
    <h2 class="show-header">{dj.showTitle}</h2>
    <p class="show-description">{dj.showDescription}</p>
    {
      djShows.length > 0 && (
        <div class="shows-grid">
          {djShows.map((show) => (
            <SquareShowCard show={show} base={import.meta.env.BASE_URL} />
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  h1 {
    margin: 0 0 var(--space-sm);
    font-size: calc(var(--font-title) * 2);
  }

  .shows-container {
    margin-top: var(--space-lg);
    overflow-wrap: anywhere;
  }

  .show-header {
    margin: 0 0 var(--space-sm);
    font-weight: normal;
    font-size: var(--font-title);
  }

  .show-description {
    margin: 0 0 var(--space-md);
  }

  .shows-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-lg);
  }

  @media (max-width: 1600px) {
    .shows-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 1023px) {
    .shows-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .shows-grid {
      gap: var(--space-sm);
    }
  }
</style>
