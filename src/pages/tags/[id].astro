---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { fetchShows, type Show } from "../../utils/fetch-shows";
import { fetchDJs, type DJ } from "../../utils/fetch-djs";
import { fetchTags, type Tag } from "../../utils/fetch-tags";
import { pathToFileURL } from "node:url";

type Props = {
  tag: Tag;
  shows: Show[];
  djs: DJ[];
};
export async function getStaticPaths() {
  const shows = await fetchShows(pathToFileURL("src/res/shows.json"));
  const djs = await fetchDJs(pathToFileURL("src/res/djs_brief.json"));
  const tags = await fetchTags(pathToFileURL("src/res/tags.json"));

  return Array.from(tags.values()).map((tag) => ({
    params: { id: String(tag.id) },
    props: {
      tag,
      shows: shows.filter((show) => show.tagIds.includes(tag.id)),
      djs: djs.filter((dj) => dj.tagIds.includes(tag.id)),
    },
  }));
}

const { /*shows, djs,*/ tag } = Astro.props as Props;
---

<BaseLayout
  page={{ name: "tag_page", color: tag.color }}
  returning_page="shows"
  title={`${tag.title} | Other Desert Radio`}
>
  <div class="detail-grid">
    <div class="detail-header">
      <h1 class="page-title">{tag.title}</h1>
    </div>
  </div>

  <style></style>
</BaseLayout>
