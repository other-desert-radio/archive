---
import { hydrateTags } from "../../utils/hydrate-tags";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LargeTagHeader from "../../components/explore/LargeTagHeader.astro";
import HorizontalScroll from "../../components/HorizontalScroll.astro";
import DJExploreCard from "../../components/explore/DJExploreCard.astro";
import { SquareShowCards } from "../../components/shows/SquareShowCard";
import { fetchShows, type Show } from "../../utils/fetch-shows";
import { fetchDJs } from "../../utils/fetch-djs";
import { fetchDJ, type HydratedDJ } from "../../utils/fetch-dj";
import { fetchTags, type Tag } from "../../utils/fetch-tags";
import { pathToFileURL } from "node:url";

type Props = {
  tag: Tag;
  shows: Show[];
  djs: HydratedDJ[];
};
export async function getStaticPaths() {
  const shows = await fetchShows(pathToFileURL("public/resources/shows.json"));
  const djs = await fetchDJs(pathToFileURL("public/resources/djs_brief.json"));
  const tags = await fetchTags(pathToFileURL("public/resources/tags.json"));
  const profiles = await Promise.all(
    djs.map(({ id }) =>
      fetchDJ(pathToFileURL(`public/resources/djs/${id}.json`)),
    ),
  );

  return Array.from(tags.values()).map((tag) => ({
    params: { id: String(tag.id) },
    props: {
      tag,
      shows: shows.filter((show) => show.tagIds.includes(tag.id)),
      djs: profiles.filter((dj) => dj.tagIds.includes(tag.id)),
    },
  }));
}

const { tag, djs, shows } = Astro.props as Props;
const tags = await fetchTags(pathToFileURL("public/resources/tags.json"));
---

<BaseLayout
  page={{ name: "tag_page", color: tag.color }}
  returning_page="explore"
  title={`${tag.title} | Other Desert Radio`}
>
  <LargeTagHeader tag={tag} />

  {
    djs.length > 0 && (
      <>
        <div class="page-inset dj-heading">
          <h2 id="tag-djs-heading">DJs</h2>
        </div>
        <HorizontalScroll class="gutter-scroll dj-row" label="DJs" gap="calc(var(--space-lg) * 4)">
          {djs.map((dj) => (
            <DJExploreCard dj={dj} fromTag={tag.id} />
          ))}
        </HorizontalScroll>
      </>
    )
  }

  {
    shows.length > 0 && (
      <section class="page-inset" aria-labelledby="tag-shows-heading">
        <div class="shows-heading-row">
          <h2 id="tag-shows-heading">SHOWS</h2>
        </div>
        <div class="shows-grid">
          <SquareShowCards
            shows={shows.map((show) => ({
              id: show.id,
              title: show.title,
              duration: show.duration,
              image_large: show.image_large,
              tags: hydrateTags(show, tags),
            }))}
            base={import.meta.env.BASE_URL}
            fromTag={tag.id}
            client:load
          />
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  section,
  .dj-heading {
    margin-top: var(--space-lg);
  }

  h2 {
    margin: 0 0 var(--space-md);
    font-size: var(--font-title);
    font-weight: 400;
  }

  .dj-row {
    min-height: var(--space-lg);
  }

  .shows-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-lg);
  }

  .shows-heading-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .shows-heading-row h2 {
    margin: 0;
  }

  @media (max-width: 1023px) {
    .shows-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .shows-grid {
      gap: var(--space-sm);
    }
  }
</style>
