---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TagView from "../../components/TagView.astro";
import PlayableShowArtwork from "../../components/shows/PlayableShowArtwork";
import { fetchShows, type Show } from "../../utils/fetch-shows";
import { fetchTags } from "../../utils/fetch-tags";
import { formatDate } from "../../utils/format-date";
import { hydrateTags } from "../../utils/hydrate-tags";
import { pathToFileURL } from "node:url";

type Props = {
  show: Show;
};
export async function getStaticPaths() {
  const shows = await fetchShows(pathToFileURL("src/res/shows.json"));

  return Promise.all(
    shows.map(async (show) => ({
      params: { id: String(show.id) },
      props: {
        show: show,
      },
    })),
  );
}

const { show } = Astro.props as Props;
const tags = await fetchTags(pathToFileURL("src/res/tags.json"));
const hydratedTags = hydrateTags(show, tags);
---

<BaseLayout
  page={{ name: "show_page" }}
  returning_page="shows"
  title={`${show.title} | Other Desert Radio`}
>
  <section class="show-grid" aria-labelledby="show-title">
    <div class="show-artwork">
      <PlayableShowArtwork
        show={show}
        base={import.meta.env.BASE_URL}
        loading="eager"
        border="secondary"
        client:load
      />
    </div>
    <div class="show-info">
      <h1 id="show-title" class="show-title">{show.title}</h1>
      <p class="show-date">{formatDate(show.date)}</p>
      <div class="tag-container">
        {hydratedTags.map((tag) => <TagView tag={tag} size="large" />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .show-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: var(--grid-column-gap);
    margin-top: var(--grid-column-gap);
  }

  .show-artwork {
    min-width: 0;
  }

  .show-info {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .show-title {
    margin: 0 0 var(--space-lg);
    font-size: clamp(var(--font-title), 4.5vw, calc(var(--font-title) * 2.5));
    line-height: 1.4;
  }

  .show-date {
    margin: 0 0 var(--space-sm);
  }

  @media (max-width: 750px) {
    .show-grid {
      gap: var(--space-lg);
      margin-top: var(--space-lg);
    }
  }

  @media (max-width: 600px) {
    .show-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
