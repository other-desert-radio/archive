---
import { getBasePath } from "../../utils/get-base-path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TagView from "../../components/TagView.astro";
import SquareShowCard from "../../components/shows/SquareShowCard";
import SaveToPlaylist from "../../components/playlists/SaveToPlaylist";
import { fetchShows, type Show } from "../../utils/fetch-shows";
import { fetchDJ, type HydratedDJ } from "../../utils/fetch-dj";
import { fetchTags } from "../../utils/fetch-tags";
import { formatDate } from "../../utils/format-date";
import { hydrateTags } from "../../utils/hydrate-tags";
import { pathToFileURL } from "node:url";
import { readFile } from "node:fs/promises";
import { isMatching } from "ts-pattern";
import {
  type ShowDetail,
  ShowDetailsExportPattern,
} from "../../stores/show-details/types";

type Props = {
  show: Show;
  djs: HydratedDJ[];
  description: string | undefined;
  tracklist: ShowDetail["tracklist"];
};
export async function getStaticPaths() {
  const shows = await fetchShows(pathToFileURL("public/resources/shows.json"));
  const exported: unknown = JSON.parse(
    await readFile("public/resources/show_details.json", "utf8"),
  );
  if (!isMatching(ShowDetailsExportPattern, exported)) {
    throw new Error("Show details have an unexpected format.");
  }
  const details = new Map(exported.data.map((detail) => [detail.id, detail]));

  return Promise.all(
    shows.map(async (show) => {
      const detail = details.get(show.id);
      if (!detail) {
        throw new Error(`Missing details for show ${show.id}`);
      }
      return {
        params: { id: String(show.id) },
        props: {
          show: show,
          description: detail.description,
          tracklist: detail.tracklist,
          djs: await Promise.all(
            show.djs.map(({ id }) =>
              fetchDJ(pathToFileURL(`public/resources/djs/${id}.json`)),
            ),
          ),
        },
      };
    }),
  );
}

const { show, djs, description, tracklist } = Astro.props as Props;
const base = getBasePath();
const tags = await fetchTags(pathToFileURL("public/resources/tags.json"));
const hydratedTags = hydrateTags(show, tags);
---

<BaseLayout
  page={{ name: "show_page" }}
  returning_page="shows"
  title={`${show.title} | Other Desert Radio`}
>
  <div class="page-inset">
    <div class="show-info">
      <header
        class="show-header"
        style={{
          "--show-title-length": Math.max(1, Array.from(show.title).length),
        }}
      >
        <h1 id="show-title" class="show-title">{show.title}</h1>
        <p class="show-date">{formatDate(show.date)}</p>
      </header>
      <div class="tag-container">
        {hydratedTags.map((tag) => <TagView tag={tag} size="large" />)}
      </div>
    </div>
    <section class="show-grid" aria-labelledby="show-title">
      <div class="show-artwork">
        <SquareShowCard
          mode="playback"
          show={show}
          base={import.meta.env.BASE_URL}
          loading="eager"
          border="secondary"
          client:load
        />
        <SaveToPlaylist showId={show.id} client:load />
      </div>
      <div class="show-description">
        {
          description && (
            <section aria-labelledby="description-title">
              <h2 id="description-title" class="description-title">
                DESCRIPTION
              </h2>
              <div class="description-content" set:html={description} />
            </section>
          )
        }
        {
          Boolean(tracklist?.length) && (
            <section aria-labelledby="tracklist-title">
              <h2 id="tracklist-title" class="description-title">
                TRACKLIST
              </h2>
              <ol class="tracklist">
                {tracklist?.map((entry) => (
                  <li>
                    {"chapter" in entry
                      ? entry.chapter
                      : `${entry.artist} — ${entry.song}`}
                  </li>
                ))}
              </ol>
            </section>
          )
        }
        <div class="show-djs">
          {
            djs.map((dj) => (
              <a
                class="show-dj"
                href={`${base}/djs/${dj.id}`}
                aria-label={`View ${dj.title}`}
                aria-labelledby={`dj-${dj.id}`}
              >
                {dj.image_large && (
                  <img
                    class="dj-portrait"
                    src={`${base}/${dj.image_large}`}
                    alt={dj.title}
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <div class="dj-profile">
                  <h2 id={`dj-${dj.id}`} class="dj-name">
                    {dj.title}
                  </h2>
                  <div class="dj-bio" set:html={dj.bio?.trim()} />
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .show-djs {
    display: flex;
    flex-direction: column;
    gap: var(--grid-column-gap);
    min-width: 0;
  }

  .show-dj {
    --dj-artwork-size: calc(var(--density-unit) * 4.5);
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    width: fit-content;
    max-width: min(100%, calc(var(--density-unit) * 72));
    color: black;
    text-decoration: none;
    cursor: pointer;
  }

  @media (hover: hover) and (pointer: fine) {
    .show-dj:hover {
      outline: var(--border-secondary) solid currentColor;
      outline-offset: var(--space-xs);
      font-style: italic;
    }
  }

  .show-dj:focus-visible {
    outline: var(--border-secondary) solid currentColor;
    outline-offset: var(--space-xs);
  }

  .dj-name {
    margin: 0 0 var(--space-sm);
    font-size: calc(var(--font-body) * 1.25);
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .dj-name:has(+ .dj-bio:empty) {
    margin-bottom: 0;
  }

  .dj-profile {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }

  .dj-portrait {
    display: block;
    width: var(--dj-artwork-size);
    flex-shrink: 0;
    max-width: var(--dj-artwork-size);
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    background-color: var(--artwork-placeholder);
  }

  .dj-bio {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .dj-bio :global(p:first-child) {
    margin-top: 0;
  }

  .dj-bio :global(p:last-child) {
    margin-bottom: 0;
  }

  .show-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.5fr) minmax(0, 1.1fr);
    width: 100%;
    margin-inline: auto;
    align-items: start;
    gap: var(--grid-column-gap);
    row-gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  .show-description {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
    overflow-wrap: anywhere;
    border-left: var(--border-secondary) solid currentColor;
    padding-left: var(--space-lg);
  }

  .tracklist {
    margin: 0;
    padding-left: var(--space-lg);
  }

  .description-title {
    margin: 0 0 var(--space-sm);
    font-size: var(--font-small-title);
    font-weight: 700;
  }

  .description-content > :global(:first-child) {
    margin-top: 0;
  }

  .description-content > :global(:last-child) {
    margin-bottom: 0;
  }

  .show-artwork {
    min-width: 0;
  }

  .show-info {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .show-header {
    container-type: inline-size;
    margin-top: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .show-title {
    margin: 0;
    font-size: min(
      clamp(var(--font-title), 4.5vw, calc(var(--font-title) * 2.5)),
      calc(100cqw / var(--show-title-length) / 0.64)
    );
    line-height: 1.4;
  }

  .show-date {
    margin: 0;
  }

  @media (max-width: 750px) {
    .show-grid {
      gap: var(--space-lg);
      margin-top: var(--space-lg);
    }
  }

  @media (max-width: 600px) {
    .show-title {
      font-size: var(--font-title);
    }

    .show-grid {
      grid-template-columns: minmax(0, 1fr);
      width: 100%;
    }

    .show-description {
      grid-column: auto;
      grid-row: auto;
    }
    .show-dj {
      flex-direction: column;
    }

    .dj-profile {
      flex: initial;
      width: 100%;
    }
  }
</style>
