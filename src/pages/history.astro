---
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryTabs from "../components/CategoryTabs.astro";
---

<BaseLayout
  title="History | Other Desert Radio"
  page={{ name: "history" }}
  returning_page="home"
>
  <CategoryTabs active="history" />
  <div class="wip">Under Construction</div>
  <style>
    .wip {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      font-size: 2rem;
      font-style: italic;
      height: 100%;
      width: 100%;
    }
  </style>
</BaseLayout>
