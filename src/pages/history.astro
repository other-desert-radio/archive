---
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryTabs from "../components/CategoryTabs.astro";
import HistoryPane from "../components/history/HistoryPane";
---

<BaseLayout
  title="History | Other Desert Radio"
  page={{ name: "history" }}
  returning_page="home"
>
  <CategoryTabs active="history" />
  <HistoryPane client:load />
</BaseLayout>

<style is:global>
  html[data-page="history"],
  html[data-page="history"] .site-background {
    background: black;
    color: white;
  }

  html[data-page="history"] main a {
    color: inherit;
  }

  html[data-page="history"] [data-site-header] nav {
    border-bottom: var(--border-primary) solid white;
  }
</style>
