---
import { pathToFileURL } from "node:url";
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryTabs from "../components/CategoryTabs.astro";
import { ShowsPane } from "../components/shows";
import { fetchShows } from "../utils/fetch-shows";
import { fetchTags } from "../utils/fetch-tags";

const tags = await fetchTags(pathToFileURL("public/resources/tags.json"));
const shows = await fetchShows(pathToFileURL("public/resources/shows.json"));
const initialShows = shows.slice(0, 20);
const initialTagIds = new Set(initialShows.flatMap((show) => show.tagIds));
const initialTags = new Map([...tags].filter(([id]) => initialTagIds.has(id)));
const base = import.meta.env.BASE_URL;
---

<!-- This is the shows page -->
<BaseLayout
  title="Archive | Other Desert Radio"
  page={{ name: "shows" }}
  returning_page="home"
>
  <CategoryTabs active="shows" />
  <ShowsPane client:load base={base} shows={initialShows} showIds={shows.map((show) => show.id)} tags={initialTags} />
</BaseLayout>
