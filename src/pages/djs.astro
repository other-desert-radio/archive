---
import { pathToFileURL } from "node:url";
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryTabs from "../components/CategoryTabs.astro";
import DJsPane from "../components/dj/DJsPane.tsx";
import { fetchDJs } from "../utils/fetch-djs";
import { fetchTags } from "../utils/fetch-tags";

const tags = await fetchTags(pathToFileURL("src/res/tags.json"));
const djs = await fetchDJs(pathToFileURL("src/res/djs_brief.json"));
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Archive | Other Desert Radio"
  page={{ name: "djs" }}
  returning_page="home"
>
  <CategoryTabs active="djs" />
  <DJsPane base={base} djs={djs} tags={tags} />
</BaseLayout>
