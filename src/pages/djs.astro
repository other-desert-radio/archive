---
import { pathToFileURL } from "node:url";
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryTabs from "../components/CategoryTabs.astro";
import DJsPane from "../components/dj/DJsPane.tsx";
import "../components/search/SearchBar.module.css";
import { fetchDJs } from "../utils/fetch-djs";
import { fetchTags } from "../utils/fetch-tags";

const tags = await fetchTags(pathToFileURL("public/resources/tags.json"));
const djs = await fetchDJs(pathToFileURL("public/resources/djs_brief.json"));
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Archive | Other Desert Radio"
  page={{ name: "djs" }}
  returning_page="home"
>
  <CategoryTabs slot="category-tabs" active="djs" />
  <div class="page-inset">
    <DJsPane client:load base={base} djs={djs} tags={tags} />
  </div>
</BaseLayout>
