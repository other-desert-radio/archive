---
import { getBasePath } from "../../utils/get-base-path";
import type { HydratedDJ } from "../../utils/fetch-dj";

type Props = {
  dj: HydratedDJ;
  fromTag?: number;
};

const { dj, fromTag } = Astro.props;
const base = getBasePath();
const query = fromTag === undefined ? "" : `?fromTag=${fromTag}`;
---

<a
  class="dj-explore-card"
  href={`${base}/djs/${dj.id}${query}`}
  aria-label={`View ${dj.title}`}
>
  <span class="artwork">
    {
      dj.image_large && (
        <img
          src={`${base}/${dj.image_large}`}
          alt={dj.title}
          loading="lazy"
          decoding="async"
        />
      )
    }
  </span>
  <h3>{dj.title}</h3>
</a>

<style>
  .dj-explore-card {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex: 0 0 auto;
    font-size: var(--font-title);
    line-height: 1.2;
    color: inherit;
    text-decoration: none;
    touch-action: manipulation;
  }

  .artwork {
    width: 1lh;
    height: 1lh;
    flex: none;
    background-color: var(--artwork-placeholder);
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  h3 {
    margin: 0;
    font: inherit;
    white-space: nowrap;
  }

  @supports (-webkit-touch-callout: none) {
    @media (max-width: 600px) {
      h3 {
        font-size: var(--font-small-title);
      }
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .dj-explore-card:hover {
      font-style: italic;
      font-weight: bold;
    }

    .dj-explore-card:hover .artwork {
      border: 4px solid black;
    }
  }

  .dj-explore-card:focus-visible {
    outline: var(--border-secondary) solid currentColor;
    outline-offset: var(--space-xs);
  }
</style>
