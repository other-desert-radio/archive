---
import type { HydratedDJ } from "../../utils/fetch-dj";

type Props = {
  dj: HydratedDJ;
};

const { dj } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<a class="dj-explore-card" href={`${base}/djs/${dj.id}`} aria-label={`View ${dj.title}`}>
  <img src={`${base}/${dj.image_large}`} alt={dj.title} loading="lazy" />
  <div class="dj-content">
    <h3>{dj.title}</h3>
    <div class="dj-description" set:html={dj.bio} />
  </div>
</a>

<style>
  .dj-explore-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    flex: 0 0 auto;
    width: min(100%, calc(var(--density-unit) * 48));
    color: inherit;
    text-decoration: none;
    touch-action: manipulation;
  }

  img {
    width: 36%;
    flex: 0 0 36%;
    max-width: var(--detail-artwork-size);
    aspect-ratio: 1;
    object-fit: cover;
  }

  .dj-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  h3 {
    margin: 0;
    font-size: var(--font-title);
    font-weight: 400;
    line-height: 1.2;
  }

  .dj-description :global(p) {
    margin: 0;
  }

  .dj-explore-card:focus-visible {
    outline: var(--border-secondary) solid currentColor;
    outline-offset: var(--space-xs);
  }

  @media (max-width: 600px) {
    .dj-explore-card {
      gap: var(--space-sm);
    }

    h3 {
      font-size: var(--space-md);
    }
  }
</style>
