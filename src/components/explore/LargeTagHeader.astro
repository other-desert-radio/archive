---
import type { Tag } from "../../utils/fetch-tags";

type Props = {
  tag: Tag;
};

const { tag } = Astro.props;
---

<div
  class="large-tag-header"
  style={{ backgroundColor: tag.color, "--tag-title-length": Math.max(1, Array.from(tag.title).length) }}
>
  <h1>{tag.title}</h1>
</div>

<style>
  .large-tag-header {
    /* Reach the viewport edge from inside BaseLayout's centered main. */
    --header-inset: calc(
      max(var(--page-gutter), env(safe-area-inset-left)) +
        max(0rem, (100vw - var(--page-max-width)) / 2)
    );
    width: fit-content;
    max-width: calc(100% + var(--header-inset));
    margin-left: calc(-1 * var(--header-inset));
    padding-block: var(--space-lg);
    padding-left: max(
      min(var(--page-gutter), 3.2rem),
      env(safe-area-inset-left)
    );
    padding-right: var(--space-lg);
    color: white;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 7vw, calc(var(--density-unit) * 8));
    font-weight: 700;
    font-style: italic;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  @media (max-width: 600px) {
    .large-tag-header {
      width: calc(
        100% + var(--header-inset) +
          max(var(--page-gutter), env(safe-area-inset-right))
      );
      max-width: none;
      padding-left: max(var(--page-gutter), env(safe-area-inset-left));
      padding-right: max(var(--page-gutter), env(safe-area-inset-right));
      text-align: center;
      container-type: inline-size;
    }

    h1 {
      width: 100%;
      font-size: calc(100cqw / var(--tag-title-length) / 0.64);
      white-space: nowrap;
    }
  }
</style>
