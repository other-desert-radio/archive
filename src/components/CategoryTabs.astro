---
import { getBasePath } from "../utils/get-base-path";
const base = `${getBasePath()}/`;
type Props = {
  active: "explore" | "shows" | "djs" | "history";
};

const { active } = Astro.props;
---

<div class="category-tabs" data-category-tabs>
  <div class="tabs-strip">
    <nav class="tabs-inset" aria-label="Archive categories">
      <div class="tabs">
        <!-- Warm visible destinations before a touch user taps, without preloading
       the entire archive. Astro respects reduced-data/slow-connection settings. -->
        <a
          data-astro-prefetch="viewport"
          aria-label="Explore archive"
          href={`${base}explore`}
          aria-current={active === "explore" ? "page" : undefined}>EXPLORE</a
        >
        <span aria-hidden="true"></span>
        <!--- TODO: have explore be the base -->
        <a
          data-astro-prefetch="viewport"
          aria-label="Browse shows"
          href={base}
          aria-current={active === "shows" ? "page" : undefined}>SHOWS</a
        >
        <span aria-hidden="true"></span>
        <a
          data-astro-prefetch="viewport"
          aria-label="Browse DJs"
          href={`${base}djs`}
          aria-current={active === "djs" ? "page" : undefined}>DJs</a
        >
        <span aria-hidden="true"></span>
        <a
          data-astro-prefetch="viewport"
          aria-label="View listening history"
          href={`${base}history`}
          aria-current={active === "history" ? "page" : undefined}>HISTORY</a
        >
      </div>
    </nav>
  </div>
</div>

<script>
  // Fling speed in CSS pixels per millisecond; slow drags keep the eased curve.
  const fastScrollPxPerMs = 0.5;

  // Native timelines follow browser scrolling; this fast-scroll fallback is only
  // for browsers missing the CSS timeline, range, math or typed-property support.
  function observeCategoryTabs(tabs: HTMLElement): () => void {
    const header = tabs.closest<HTMLElement>("[data-site-header]");
    const styles = getComputedStyle(tabs);
    const compressionScrollPx = Number.parseFloat(styles.getPropertyValue("--tabs-compression-scroll-px"));
    const easeOutPower = Number.parseFloat(styles.getPropertyValue("--tabs-ease-out-power"));
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let frame: number | undefined;
    let lastProgress: number | undefined;
    let lastScrollY = window.scrollY;
    let lastScrollTime = performance.now();
    let snapDirection = 0;

    function update(): void {
      frame = undefined;
      const now = performance.now();
      const scrollY = window.scrollY;
      const delta = scrollY - lastScrollY;
      // An idle gap is not part of the next gesture's velocity sample.
      const sampleMs = Math.min(32, Math.max(1, now - lastScrollTime));
      const fast = !reducedMotion.matches && Math.abs(delta) / sampleMs >= fastScrollPxPerMs;
      const direction = Math.sign(delta);
      if (direction !== 0 && direction !== snapDirection) {
        snapDirection = 0;
      }
      if (scrollY <= 0 || scrollY >= compressionScrollPx || reducedMotion.matches) {
        snapDirection = 0;
      } else if (fast) {
        snapDirection = direction;
      }
      lastScrollY = scrollY;
      lastScrollTime = now;
      const fastScroll = fast || snapDirection !== 0;
      // Keep the bypass through endpoint settling so a trailing fade cannot resume.
      if (fastScroll) {
        tabs.toggleAttribute("data-fast-scroll", true);
      }
      const scrollProgress = reducedMotion.matches
        ? 1
        : snapDirection > 0
          ? 1
          : snapDirection < 0
            ? 0
            : Math.min(1, Math.max(0, scrollY / compressionScrollPx));
      const progress = 1 - (1 - scrollProgress) ** easeOutPower;
      if (progress === lastProgress) {
        return;
      }
      lastProgress = progress;
      tabs.toggleAttribute("data-fast-scroll", fastScroll);
      tabs.style.setProperty("--tabs-progress", String(progress));
      header?.style.setProperty("--tabs-progress", String(progress));
      tabs.toggleAttribute("data-compact", scrollProgress === 1);
      tabs.toggleAttribute("data-expanded", scrollProgress === 0);
      tabs.toggleAttribute("data-dark", progress >= 0.5);
    }

    function scheduleUpdate(): void {
      if (frame === undefined) {
        frame = window.requestAnimationFrame(update);
      }
    }

    function restoreScroll(): void {
      if (frame !== undefined) {
        window.cancelAnimationFrame(frame);
      }
      frame = window.requestAnimationFrame(() => {
        // History restoration is a new starting position, not a fling.
        snapDirection = 0;
        lastScrollY = window.scrollY;
        lastScrollTime = performance.now();
        update();
      });
    }

    window.addEventListener("scroll", scheduleUpdate, { passive: true });
    window.addEventListener("pageshow", restoreScroll);
    reducedMotion.addEventListener("change", scheduleUpdate);
    update();
    scheduleUpdate();

    return () => {
      window.removeEventListener("scroll", scheduleUpdate);
      window.removeEventListener("pageshow", restoreScroll);
      reducedMotion.removeEventListener("change", scheduleUpdate);
      if (frame !== undefined) {
        window.cancelAnimationFrame(frame);
      }
    };
  }

  let stopObservingTabs: (() => void) | undefined;
  let categoryEntryScroll: number | undefined;

  function disposeCategoryTabs(): void {
    stopObservingTabs?.();
    stopObservingTabs = undefined;
  }

  function initializeCategoryTabs(): void {
    disposeCategoryTabs();
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    header?.removeAttribute("data-tabs-driver");
    header?.style.removeProperty("--tabs-progress");
    const tabs = document.querySelector<HTMLElement>("[data-category-tabs]");
    document.body.toggleAttribute("data-compact-category-entry", !!tabs && !!history.state?.categoryTabsCompactEntry);
    if (tabs && header) {
      tabs.style.removeProperty("--tabs-progress");
      if (
        typeof CSS.registerProperty === "function" &&
        CSS.supports("(animation-timeline: scroll(root block)) and (animation-range: 0px 40px) and (width: calc(1px * pow(0.5, 3)))")
      ) {
        header.dataset["tabsDriver"] = "css";
        return;
      }
      header.dataset["tabsDriver"] = "js";
      stopObservingTabs = observeCategoryTabs(tabs);
    }
  }

  initializeCategoryTabs();
  document.addEventListener("astro:page-load", initializeCategoryTabs);
  document.addEventListener("astro:before-swap", (event) => {
    disposeCategoryTabs();
    categoryEntryScroll = undefined;
    const tabs = document.querySelector<HTMLElement>("[data-category-tabs]");
    const nextTabs = event.newDocument.querySelector<HTMLElement>("[data-category-tabs]");
    if (!nextTabs) {
      return;
    }
    const distance = Number.parseFloat(getComputedStyle(tabs ?? document.documentElement).getPropertyValue("--tabs-compression-scroll-px"));
    if (event.navigationType === "traverse") {
      if (history.state?.categoryTabsCompactEntry || history.state?.scrollY >= distance) {
        categoryEntryScroll = history.state.scrollY;
      }
    } else if (
      tabs && event.sourceElement?.closest("[data-category-tabs] a") &&
      Number.parseFloat(getComputedStyle(tabs).getPropertyValue("--tabs-progress")) >= 1
    ) {
      categoryEntryScroll = distance;
    }
    if (categoryEntryScroll !== undefined && categoryEntryScroll >= distance) {
      event.newDocument.querySelector<HTMLElement>("[data-site-header]")?.style.setProperty("--tabs-progress", "1");
      nextTabs.style.setProperty("--tabs-progress", "1");
      nextTabs.toggleAttribute("data-dark", true);
      nextTabs.toggleAttribute("data-fast-scroll", true);
    }
  });
  document.addEventListener("astro:after-swap", () => {
    document.body.toggleAttribute("data-compact-category-entry", categoryEntryScroll !== undefined);
    if (categoryEntryScroll !== undefined) {
      window.scrollTo({ top: categoryEntryScroll, left: 0, behavior: "instant" });
      history.replaceState({ ...history.state, categoryTabsCompactEntry: true, scrollY: window.scrollY }, "");
    }
    categoryEntryScroll = undefined;
  });
</script>

<style>
  .category-tabs {
    --tabs-progress: 0;
    --tabs-expanded-font: var(--tabs-font-size);
    --tabs-expanded-gap: var(--space-lg);
    --tabs-expanded-left: var(--page-inset-left);
    --tabs-expanded-right: var(--page-inset-right);
    --tabs-gap: calc(
      var(--tabs-expanded-gap) + (var(--space-sm) - var(--tabs-expanded-gap)) *
        var(--tabs-progress)
    );
    /* Reserve flow space so compression cannot change scroll position or page length. */
    height: calc(
      var(--space-sm) + max(2.75rem, var(--tabs-expanded-font) * 1.5) +
        var(--space-md) + var(--tabs-title-lift, 0rem) * var(--tabs-progress)
    );
    pointer-events: none;
  }

  .tabs-strip {
    padding-top: calc(var(--space-sm) * (1 - var(--tabs-progress)));
    padding-bottom: calc(var(--space-md) * (1 - var(--tabs-progress)));
    background: rgb(0 0 0 / var(--tabs-progress));
    color: black;
    pointer-events: auto;
    transition: background-color 120ms ease-out, color 120ms ease-out;
  }

  .category-tabs[data-fast-scroll] .tabs-strip,
  .category-tabs[data-expanded] .tabs-strip {
    transition: none;
  }

  .category-tabs[data-dark] .tabs-strip {
    color: white;
  }

  :global(header[data-tabs-driver="css"]) .category-tabs {
    --tabs-progress: inherit;
  }

  :global(header[data-tabs-driver="css"]) .tabs-strip {
    transition: none;
    animation: category-tabs-ink 1s steps(1, end) both;
    animation-range: 0px calc(var(--tabs-compression-scroll-px) * (1 - pow(0.5, 1 / var(--tabs-ease-out-power))) * 1px);
  }

  :global(header[data-tabs-driver="css"]) .category-tabs .tabs-strip {
    animation-timeline: scroll(root block);
  }

  @keyframes category-tabs-ink {
    from { color: black; }
    to { color: white; }
  }

  .tabs-inset {
    width: 100%;
    max-width: calc(
      var(--page-max-width) + (100% - var(--page-max-width)) *
        var(--tabs-progress)
    );
    margin-inline: auto;
    padding-left: calc(
      var(--tabs-expanded-left) +
        (
          max(var(--nav-inline-padding), env(safe-area-inset-left)) -
            var(--tabs-expanded-left)
        ) *
        var(--tabs-progress)
    );
    padding-right: calc(
      var(--tabs-expanded-right) +
        (
          max(var(--nav-inline-padding), env(safe-area-inset-right)) -
            var(--tabs-expanded-right)
        ) *
        var(--tabs-progress)
    );
  }

  .tabs {
    display: flex;
    flex-wrap: nowrap;
    justify-content: flex-start;

    gap: var(--tabs-gap);
    font-size: calc(
      var(--tabs-expanded-font) +
        (var(--font-small) - var(--tabs-expanded-font)) * var(--tabs-progress)
    );
  }

  .tabs > span {
    display: none;
  }

  a {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    min-width: 2.75rem;
    white-space: nowrap;
    text-decoration: none;
    color: inherit;
  }

  @media (max-width: 750px) {
    .category-tabs {
      --tabs-expanded-font: clamp(0.875rem, 3.5vw, var(--tabs-font-size));
      --tabs-expanded-gap: clamp(var(--space-sm), 4vw, var(--space-lg));
    }
  }

  @media (max-width: 600px) {
    .category-tabs {
      --tabs-expanded-left: calc(var(--page-inset-left) + var(--space-md));
      --tabs-expanded-right: calc(var(--page-inset-right) + var(--space-md));
    }

    .tabs {
      gap: 0;
    }

    /* Move spare space from between links to the end as the phone row contracts. */
    .tabs > span {
      display: block;
      flex: calc(1 - var(--tabs-progress)) 1 0;
      margin-left: var(--tabs-gap);
    }

    .tabs::after {
      content: "";
      flex: calc(3 * var(--tabs-progress)) 1 0;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    a:hover {
      text-decoration: underline;
    }
  }

  a[aria-current="page"] {
    font-weight: bold;
    text-decoration: underline;
    text-decoration-thickness: calc(
      var(--border-heavy) + (var(--border-secondary) - var(--border-heavy)) *
        var(--tabs-progress)
    );
  }

  a {
    text-underline-offset: 0.3em;
  }

  @media (prefers-reduced-motion: reduce) {
    .category-tabs {
      --tabs-progress: 1;
      height: auto;
    }

    .tabs-strip {
      background: black;
      color: white;
      transition: none;
    }

    :global(header[data-tabs-driver="css"]) .tabs-strip {
      animation: none;
      color: white;
    }

  }
</style>
