---
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
type Props = {
  active: "explore" | "shows" | "djs" | "history";
};

const { active } = Astro.props;
---

<div class="tabs">
  <a
    href={`${base}explore`}
    aria-current={active === "explore" ? "page" : undefined}>EXPLORE</a
  >
  <!--- TODO: have explore be the base -->
  <a href={base} aria-current={active === "shows" ? "page" : undefined}>SHOWS</a
  >
  <a href={`${base}djs`} aria-current={active === "djs" ? "page" : undefined}
    >DJs</a
  >
  <a
    href={`${base}history`}
    aria-current={active === "history" ? "page" : undefined}>HISTORY</a
  >
</div>

<style>
  .tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;

    gap: var(--space-md);

    padding-left: var(--space-md);
    padding-right: var(--space-md);

    margin-top: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  a {
    text-decoration: none;
    color: black;
    font-size: var(--tabs-font-size);
  }

  @media (hover: hover) and (pointer: fine) {
    a:hover {
      border-bottom: var(--border-primary) solid;
    }
  }

  a[aria-current="page"] {
    font-weight: bold;
    border-bottom: var(--border-heavy) solid;
  }
</style>
