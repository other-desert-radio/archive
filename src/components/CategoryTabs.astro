---
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
type Props = {
  active: "shows" | "djs";
};

const { active } = Astro.props;
---

<div class="tabs">
  <a href={base} aria-current={active === "shows" ? "page" : undefined}>SHOWS</a
  >
  <a href={`${base}djs`} aria-current={active === "djs" ? "page" : undefined}
    >DJs</a
  >
</div>

<style>
  .tabs {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-sm);
    margin-top: var(--space-md);
    margin-bottom: var(--space-sm);
  }

  a {
    text-decoration: none;
    color: black;
    font-size: var(--tabs-font-size);
  }

  @media (hover: hover) and (pointer: fine) {
    a:hover {
      border-bottom: var(--border-primary) solid;
    }
  }

  a[aria-current="page"] {
    font-weight: bold;
    border-bottom: var(--border-heavy) solid;
  }
</style>
