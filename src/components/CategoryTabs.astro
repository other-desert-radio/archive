---
import { getBasePath } from "../utils/get-base-path";
const base = `${getBasePath()}/`;
type Props = {
  active: "explore" | "shows" | "djs" | "history";
};

const { active } = Astro.props;
---

<div class="page-inset" data-category-tabs>
  <div class="tabs">
    <!-- Warm visible destinations before a touch user taps, without preloading
       the entire archive. Astro respects reduced-data/slow-connection settings. -->
    <a
      data-astro-prefetch="viewport"
      href={`${base}explore`}
      aria-current={active === "explore" ? "page" : undefined}>EXPLORE</a
    >
    <!--- TODO: have explore be the base -->
    <a
      data-astro-prefetch="viewport"
      href={base}
      aria-current={active === "shows" ? "page" : undefined}>SHOWS</a
    >
    <a
      data-astro-prefetch="viewport"
      href={`${base}djs`}
      aria-current={active === "djs" ? "page" : undefined}>DJs</a
    >
    <a
      data-astro-prefetch="viewport"
      href={`${base}history`}
      aria-current={active === "history" ? "page" : undefined}>HISTORY</a
    >
  </div>
</div>

<script>
  // Use one JS scroll driver across browsers to keep compression and the endpoint
  // color switch consistent without a separate CSS scroll-timeline fallback.
  function observeCategoryTabs(tabs: HTMLElement): () => void {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let frame: number | undefined;

    function update(): void {
      frame = undefined;
      const progress = reducedMotion.matches
        ? 1
        : Math.min(1, Math.max(0, window.scrollY / 160));
      tabs.style.setProperty("--tabs-progress", String(progress));
      tabs.toggleAttribute("data-compact", progress === 1);
    }

    function scheduleUpdate(): void {
      if (frame === undefined) {
        frame = window.requestAnimationFrame(update);
      }
    }

    window.addEventListener("scroll", scheduleUpdate, { passive: true });
    window.addEventListener("pageshow", scheduleUpdate);
    reducedMotion.addEventListener("change", scheduleUpdate);
    update();
    scheduleUpdate();

    return () => {
      window.removeEventListener("scroll", scheduleUpdate);
      window.removeEventListener("pageshow", scheduleUpdate);
      reducedMotion.removeEventListener("change", scheduleUpdate);
      if (frame !== undefined) {
        window.cancelAnimationFrame(frame);
      }
    };
  }

  let stopObservingTabs: (() => void) | undefined;

  function disposeCategoryTabs(): void {
    stopObservingTabs?.();
    stopObservingTabs = undefined;
  }

  function initializeCategoryTabs(): void {
    disposeCategoryTabs();
    const tabs = document.querySelector<HTMLElement>("[data-category-tabs]");
    if (tabs) {
      stopObservingTabs = observeCategoryTabs(tabs);
    }
  }

  initializeCategoryTabs();
  document.addEventListener("astro:page-load", initializeCategoryTabs);
  document.addEventListener("astro:before-swap", disposeCategoryTabs);
</script>

<style>
  .tabs {
    display: flex;
    flex-wrap: nowrap;
    justify-content: flex-start;

    gap: var(--space-lg);

    margin-top: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  a {
    flex-shrink: 0;
    white-space: nowrap;
    text-decoration: none;
    color: black;
    font-size: var(--tabs-font-size);
  }

  @media (max-width: 750px) {
    .tabs {
      gap: clamp(var(--space-sm), 4vw, var(--space-lg));
      padding-inline: 0;
    }

    a {
      font-size: clamp(0.875rem, 3.5vw, var(--tabs-font-size));
    }
  }

  @media (max-width: 600px) {
    .tabs {
      justify-content: space-between;
      padding-left: var(--space-md);
      padding-right: var(--space-md);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    a:hover {
      border-bottom: var(--border-primary) solid;
    }
  }

  a[aria-current="page"] {
    font-weight: bold;
    border-bottom: var(--border-heavy) solid;
  }
</style>
