---
import Miniplayer from "./Miniplayer";

type Props = {
  page: "shows" | "djs" | "dj_page" | "show_page";
  returning_page: "shows" | "djs" | "home";
};

const { page, returning_page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const returnHref = (() => {
  switch (returning_page) {
    case "shows": {
      return `${base}/`;
    }
    case "djs":
      return `${base}/djs`;
    case "home":
      return "https://otherdesertradio.com";
  }
})();

const title = (() => {
  switch (page) {
    case "shows":
    case "djs": {
      return "archive";
    }
    case "dj_page":
    case "show_page": {
      return page;
    }
  }
})();
---

<nav aria-label="Navigation title">
  <a
    class="leading-box"
    title={`Return to ${returning_page}`}
    href={returnHref}
  >
    <span aria-hidden="true">←</span>
    <b>{returning_page.toUpperCase()}</b>
  </a>

  <span>OTHER DESERT RADIO / {title.toUpperCase()}</span>
  <div class="miniplayer-slot">
    <Miniplayer client:load transition:persist="miniplayer" />
  </div>
</nav>

<style>
  nav {
    --nav-inline-padding: calc(var(--density-unit) * 3.125);
    min-height: var(--nav-height);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-sm);
    overflow-wrap: anywhere;
    padding: 0 var(--nav-inline-padding);
    align-items: center;

    font-size: var(--font-small);

    position: sticky;
    top: 0;
    z-index: 100;

    background: black;
    color: white;
  }

  nav > span,
  .leading-box {
    padding-block: calc(var(--density-unit) * 1.5625);
  }

  nav > span {
    min-width: 0;
    max-width: 100%;
  }

  .miniplayer-slot {
    min-width: 0;
    max-width: 100%;
    margin-inline-start: auto;
    width: min(100%, 40rem);
    min-height: 3.75rem;
  }

  .leading-box {
    flex: 0 0 auto;
    display: flex;
    flex-direction: row;
    gap: calc(var(--density-unit) * 0.3125);
    color: inherit;
    text-decoration: none;
  }

  .leading-box:hover {
    font-weight: bold;
    text-decoration: underline;
  }
  @media (max-width: 750px) {
    nav { --nav-inline-padding: var(--page-gutter); }
  }
</style>
