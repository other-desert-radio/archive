---
import { getBasePath } from "../utils/get-base-path";
import Miniplayer from "./miniplayer";
import type { Page } from "../types/page";

type Props = {
  page: Page;
  returning_page: "shows" | "djs" | "home" | "explore";
};

const { page, returning_page } = Astro.props;
const base = getBasePath();
const returnHref = (() => {
  switch (returning_page) {
    case "shows": {
      return `${base}/`;
    }
    case "djs":
      return `${base}/djs`;
    case "explore":
      return `${base}/explore`;
    case "home":
      return "https://otherdesertradio.com";
  }
})();

const title = (() => {
  switch (page.name) {
    case "explore":
    case "history":
    case "shows":
    case "djs": {
      return "archive";
    }
    case "dj_page":
    case "tag_page":
    case "show_page": {
      return page.name;
    }
  }
})();
---

<header data-site-header>
  <nav
    aria-label="Navigation title"
    style={page.name === "tag_page" ? { backgroundColor: page.color } : undefined}
  >
    <a
      class="leading-box"
      title={`Return to ${returning_page}`}
      aria-label={`Return to ${returning_page}`}
      href={returnHref}
      data-tag-return={page.name === "show_page" || page.name === "dj_page" ? "" : undefined}
      data-return-href={returnHref}
      data-return-label={returning_page.toUpperCase()}
    >
      <span aria-hidden="true">←</span>
      <b>{returning_page.toUpperCase()}</b>
    </a>

    <span>OTHER DESERT RADIO / {title.toUpperCase()}</span>
  </nav>
  <div class="miniplayer-slot" data-miniplayer-bar>
    <Miniplayer base={base} client:load transition:persist="miniplayer" />
  </div>
</header>

<script>
  import tags from "../res/tags.json";
  import { getTagReturn } from "../utils/tag-return";

  // Publishes the bar's full height (including bottom safe-area padding) as
  // --miniplayer-height on the root, so BaseLayout can reserve mobile space.
  // The returned cleanup releases the observer when this bar is replaced.
  function observeMiniplayerHeight(bar: HTMLElement): () => void {
    const updateHeight = () => {
      document.documentElement.style.setProperty(
        "--miniplayer-height",
        `${bar.getBoundingClientRect().height}px`,
      );
    };
    const observer = new ResizeObserver(updateHeight);
    observer.observe(bar, { box: "border-box" });
    updateHeight();

    return () => {
      observer.disconnect();
      document.documentElement.style.removeProperty("--miniplayer-height");
    };
  }

  let stopObservingMiniplayer: (() => void) | undefined;

  // Rebind after both normal page swaps and the iframe-preserving swap.
  // Root attributes are replaced during navigation even when the bar persists.
  function initializeMiniplayerHeight(): void {
    stopObservingMiniplayer?.();
    stopObservingMiniplayer = undefined;
    const bar = document.querySelector<HTMLElement>("[data-miniplayer-bar]");
    if (bar) {
      stopObservingMiniplayer = observeMiniplayerHeight(bar);
    }
  }

  initializeMiniplayerHeight();
  document.addEventListener("astro:page-load", initializeMiniplayerHeight);

  function updateTagReturn() {
    const link = document.querySelector<HTMLAnchorElement>("[data-tag-return]");
    const label = link?.querySelector("b");
    if (!link || !label) {
      return;
    }

    const destination = getTagReturn(location.search, import.meta.env.BASE_URL, tags);
    const href = destination?.href ?? link.dataset["returnHref"];
    const text = destination?.label ?? link.dataset["returnLabel"];
    if (!href || !text) {
      return;
    }

    link.href = href;
    label.textContent = text;
    link.title = `Return to ${text}`;
    link.setAttribute("aria-label", `Return to ${text}`);
  }

  updateTagReturn();
  document.addEventListener("astro:page-load", updateTagReturn);
</script>

<style>
  header {
    --nav-inline-padding: calc(var(--density-unit) * 3.125);
    position: sticky;
    top: 0;
    z-index: 100;
    color: white;
  }

  nav {
    min-height: var(--nav-height);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-sm);
    overflow-wrap: anywhere;
    padding-top: env(safe-area-inset-top);
    padding-left: max(var(--nav-inline-padding), env(safe-area-inset-left));
    padding-right: max(var(--nav-inline-padding), env(safe-area-inset-right));
    align-items: center;

    font-size: var(--font-small);

    background: black;
    color: white;
  }

  nav > span,
  .leading-box {
    padding-block: calc(var(--density-unit) * 1.5625);
  }

  nav > span {
    min-width: 0;
    max-width: 100%;
  }

  .miniplayer-slot {
    min-width: 0;
    max-width: 100%;
    width: 100%;
    background: var(--miniplayer-background);
    font-size: var(--font-small);
  }

  .leading-box {
    flex: 0 0 auto;
    display: flex;
    flex-direction: row;
    gap: calc(var(--density-unit) * 0.3125);
    color: inherit;
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .leading-box:hover {
      font-weight: bold;
      text-decoration: underline;
    }
  }
  @media (max-width: 750px) {
    header { --nav-inline-padding: var(--page-gutter); }
  }
  @media (max-width: 600px) {
    .miniplayer-slot {
      position: fixed;
      inset-inline: 0;
      bottom: 0;
    }

    .miniplayer-slot:has([data-miniplayer], iframe) {
      padding-bottom: env(safe-area-inset-bottom);
      padding-left: env(safe-area-inset-left);
      padding-right: env(safe-area-inset-right);
    }
  }
</style>
