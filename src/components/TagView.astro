---
import { getBasePath } from "../utils/get-base-path";
import type { Tag } from "../utils/fetch-tags";

type Props = {
  tag: Tag;
  size: "normal" | "large";
};

const { tag, size } = Astro.props as Props;
const base = getBasePath();
---

<a href={`${base}/tags/${tag.id}`} aria-label={`Explore ${tag.title}`} class:list={["tag", { "tag-large": size === "large" }]} style={`background-color: ${tag.color}`}>
  {tag.title}
</a>
