{
	"name": "archive-site",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "./scripts/dev",
		"check": "astro check",
		"docs:check": "sh scripts/check-docs",
		"build": "astro build",
		"format": "./scripts/format",
		"lint": "./scripts/lint",
		"lint:format": "biome format .",
		"lint:eslint": "bun --bun eslint .",
		"lint:shell": "find .githooks scripts -type f -exec sh -n {} +",
		"lint:types": "tsc --noEmit --project tsconfig.lint.json",
		"test": "bun test",
		"test:performance": "bun run build && bun tests/performance-budget.mjs && bun tests/mobile-navigation.browser.mjs",
		"prepare": "./scripts/setup-hooks.sh",
		"preview": "astro preview",
		"astro": "astro"
	},
	"dependencies": {
		"@astrojs/react": "^6.0.5",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"astro": "^7.3.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"ts-pattern": "^5.9.0"
	},
	"allowScripts": {
		"esbuild": true
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "^2.5.13",
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.2",
		"ajv": "^8.20.0",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-astro": "^3.1.0",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"typescript": "^6",
		"typescript-eslint": "^8.69.0"
	}
}
